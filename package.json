{
  "name": "scoop-master",
  "version": "0.1.0",
  "private": true,
  "description": "SCOOP MASTER \u2014 Soft-Serve Ice Cream Partnership & Business Management System",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:demo": "tsx prisma/demo.ts",
    "db:reset": "prisma migrate reset --force",
    "alerts:run": "tsx scripts/run-alerts.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "decimal.js": "10.6.0",
    "exceljs": "4.4.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "lucide-react": "0.511.0",
    "next": "15.3.9",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "recharts": "2.15.4",
    "server-only": "^0.0.1",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.1",
    "eslint-config-next": "15.3.9",
    "postcss": "8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "recharts": {
      "react-is": "19.1.1"
    }
  }
}
