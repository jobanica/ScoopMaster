# PostgreSQL connection
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/scoopmaster?schema=public"
# Direct (non-pooled) connection used by `prisma migrate`. Locally the same as DATABASE_URL.
# Supabase: DATABASE_URL = transaction pooler (port 6543) + "?pgbouncer=true&connection_limit=1",
#           DIRECT_URL   = session pooler (port 5432) on the same pooler host.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/scoopmaster?schema=public"
# 64 random hex characters: openssl rand -hex 32
SESSION_SECRET="replace-with-64-random-hex-chars"
# Persistent directory for uploaded contracts, IDs, photos and proofs of payment (outside the web root)
UPLOAD_DIR="./storage/uploads"
# "local" (UPLOAD_DIR on disk) or "database" (bytes in Postgres — automatic on Vercel)
STORAGE_DRIVER="local"
# Secret for POST /api/cron/alerts (Authorization: Bearer <secret>)
CRON_SECRET="replace-with-random-secret"
APP_URL="http://localhost:3000"
# Optional, used by `npm run db:seed` for the first Super Admin
# SEED_ADMIN_EMAIL="owner@example.com"
# SEED_ADMIN_PASSWORD="a-strong-password-123"
